# ============================================================
# Vaultwarden TOS 7 应用中心 deb 打包配置
# 修改后重新运行 ./build.sh 即可
# ============================================================

# Vaultwarden 上游版本（GitHub tag，不带 v 前缀）
VAULTWARDEN_VERSION=1.37.3

# 随包 web vault 版本（bw_web_builds 官方发布 tag，不带 v 前缀；
# 与上游 1.37.3 的官方 Dockerfile 钉定版本一致，fetch 校验其 sha256）
WEB_VAULT_VERSION=2026.7.0

# 封装迭代号（我们自己的发布序号）
# 完整版本 = 上游版本-迭代号，例如 1.37.3-1
# 三处必须一致：config.ini / DEBIAN/control / .lang；每次提交严格递增
# Release tag 须等于该版本（如 v1.37.3-1）
# ⚠️ 迭代号永远不要零填充：dpkg 认为 -01 == -1
PKG_RELEASE=3

# 目标架构（TOS NAS 的 CPU 架构）:
#   amd64 - Intel/AMD x86_64（绝大多数 TerraMaster NAS）
#   arm64 - ARM64/aarch64 机型
TARGET_ARCH=amd64

# TOS 应用 id（/usr/local/<appid>/ 目录、config.ini 的 id/system_id、
# lang 文件名、图标文件名必须全部一致；上架后不可变更）
APP_ID=vaultwarden

# 运行用户（规范要求专用非 root 用户，preinst 创建；
# config.ini.user 与 systemd User 必须一致）
APP_USER=vaultwarden

# 回环监听端口（服务仅监听 127.0.0.1:<port>，外部一律经 TOS nginx
# 网关路由 /vaultwarden/ 访问；该端口不出现在任何用户可见文案中）
APP_PORT=8222

# ---------------- 二进制来源（V6 审核关键，见 docs/DESIGN_DECISIONS.md D-011）----------------
# source = 本仓库 GitHub Actions 从上游源码 tag 自建的静态二进制（默认，
#          上架必用；产物带可追溯的 CI 运行记录，sha256 双重校验）
# compat = 从上游官方 Docker 镜像提取（仅限本地开发调试，产物不得提交商店：
#          预编译 ELF 无源码可溯，V6 一票否决）
BINARY_SOURCE=source

# 公开构建仓库（official 字段 + fetch 来源；上架后不可变更）
REPO_URL="https://github.com/Moechz/vaultwarden"

# CI 自建产物 sha256 钉死值（对应 Release v<VERSION_FULL> 资产，
# 与 Release 内 SHA256SUMS 双重比对；升级上游版本时必须重出 CI 后回填）
VW_SHA256_AMD64=8f1fcfe181e95273c47b6914468acc5ded0c5c419471b4234b846b09e168c076
VW_SHA256_ARM64=6ec3da58d49a9a82dff8b7602de1453638dcceb66c24728e897b294216d7e272
# bw_web_builds 官方 web-vault tar.gz 的 sha256（与 Release 内副本双重比对）
WEB_VAULT_SHA256=002e972bf0d0487ec0324b06d916de33e29de4c29bffd92ee3b843084c300570

# ---------------- 署名（用户定夺 2026-09-19）----------------
# DEBIAN/control 的 Maintainer 与 config.ini 的 publisher（打包者/发布者）
MAINTAINER_NAME="Moechz"
MAINTAINER_EMAIL="moechz@users.noreply.github.com"
PUBLISHER="Moechz"
# .lang 各语 auth（上游原始作者，与 publisher 分工：作者归上游、发布归打包者）
AUTHOR="Daniel García"

# 兼容模式（BINARY_SOURCE=compat 时）的上游镜像
IMAGE_REPO=vaultwarden/server
IMAGE_TAG_VARIANT=-alpine
