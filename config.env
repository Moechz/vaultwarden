# ============================================================
# Vaultwarden TOS 7 应用中心 deb 打包配置
# 修改后重新运行 ./build.sh 即可
# ============================================================

# Vaultwarden 上游版本（GitHub tag，不带 v 前缀；也是 Docker 镜像 tag）
VAULTWARDEN_VERSION=1.37.3

# 随包 web vault 版本（信息性字段：与二进制配套，取自同一镜像层，
# 由 fetch 阶段读取 web-vault/version.json 自动核对，不在此手工维护）
# WEB_VAULT_VERSION=auto

# 封装迭代号（我们自己的发布序号）
# 完整版本 = 上游版本-迭代号，例如 1.37.3-1
# 三处必须一致：config.ini / DEBIAN/control / .lang；每次提交严格递增
# Release tag 须等于该版本（如 v1.37.3-1）
# ⚠️ 迭代号永远不要零填充：dpkg 认为 -01 == -1
PKG_RELEASE=1

# 目标架构（TOS NAS 的 CPU 架构）:
#   amd64 - Intel/AMD x86_64（绝大多数 TerraMaster NAS）
#   arm64 - ARM64/aarch64 机型
TARGET_ARCH=amd64

# TOS 应用 id（/usr/local/<appid>/ 目录、config.ini 的 id/system_id、
# lang 文件名、图标文件名必须全部一致；上架后不可变更）
APP_ID=vaultwarden

# 运行用户（规范要求专用非 root 用户，preinst 创建；
# config.ini.user 与 systemd User 必须一致）
APP_USER=vaultwarden

# 对外监听端口（直开端口模式：桌面图标打开 http://${ip}:<port>，
# 各端客户端也直连该地址；官方推荐 8000-19999 段，8222 为
# vaultwarden 社区事实标准的端口习惯，便于用户迁移）
APP_PORT=8222

# 二进制来源：官方 Docker 镜像的 alpine 变体
# （GitHub Release 自 1.37.x 起不再附二进制；默认镜像 tag 的二进制
#   是 Debian trixie glibc 动态链接（GLIBC_2.39），TOS7 的 glibc 2.35
#   跑不了；<tag>-alpine 内为 static-pie musl 全静态二进制，直接可跑）
IMAGE_REPO=vaultwarden/server
IMAGE_TAG_VARIANT=-alpine

# deb 维护者信息（DEBIAN/control 的 Maintainer 与 config.ini 的 publisher）
MAINTAINER_NAME="Moechz"
MAINTAINER_EMAIL="moechz@users.noreply.github.com"
PUBLISHER="Moechz"
