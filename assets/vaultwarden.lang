[en-us]
name         = "Vaultwarden Password Manager"
auth         = "Daniel García"
version      = "@@VERSION@@"
descript     = "Vaultwarden is a self-hosted, Bitwarden-compatible password manager server written in Rust. It ships the official web vault (login page) and an admin panel at /vaultwarden/admin where you manage users, organizations, invitations, WebSocket notifications and attachments. All Bitwarden browser extensions, desktop and mobile apps connect through the /vaultwarden/ route. Runs as a dedicated unprivileged user in a hardened systemd sandbox; data is stored in /var/lib/vaultwarden. Privacy policy: /vaultwarden/privacy-policy.html."
release_note = "Bundles the Vaultwarden @@UPSTREAM@@ server built from the official source release (CI-built static binary, see PROVENANCE.md) plus the matching web vault @@WEBVAULT@@. A random ADMIN_TOKEN for the /vaultwarden/admin panel is generated during installation: SSH in and run 'grep ADMIN_TOKEN /usr/local/vaultwarden/vaultwarden.env'. Point your Bitwarden clients at http(s)://<your-NAS>/vaultwarden. WebSocket notifications work out of the box."
important    = "The browser web vault needs HTTPS to unlock (browser WebCrypto secure-context restriction, inherent to all Bitwarden web vaults). On a plain-HTTP LAN use the Bitwarden apps/extensions, or enable HTTPS on the NAS / put a reverse proxy in front. After install, open the page immediately and create your account: the first person to register owns the vault; then disable open sign-ups (SIGNUPS_ALLOWED) or use the admin panel. 'apt remove' keeps /var/lib/vaultwarden, 'apt purge' deletes your entire vault database."

[zh-cn]
name         = "Vaultwarden 密码管理服务器"
auth         = "Daniel García"
version      = "@@VERSION@@"
descript     = "Vaultwarden 是用 Rust 编写的自托管密码管理服务器，与 Bitwarden 协议完全兼容。自带官方网页保管库（登录页），并提供 /vaultwarden/admin 管理后台，可管理用户、组织、邀请、WebSocket 实时通知与附件。各类 Bitwarden 客户端——浏览器插件、桌面端、移动 App——均通过 /vaultwarden/ 路由接入。服务以专用非特权用户运行并施加 systemd 沙箱加固，数据保存在 /var/lib/vaultwarden。隐私政策：/vaultwarden/privacy-policy.html。"
release_note = "内置由官方源码发布构建的 Vaultwarden @@UPSTREAM@@ 服务端（CI 自建静态二进制，溯源见 PROVENANCE.md）及配套网页保管库 @@WEBVAULT@@。安装时会自动生成管理后台 /vaultwarden/admin 的随机 ADMIN_TOKEN：SSH 登录 NAS 执行 grep ADMIN_TOKEN /usr/local/vaultwarden/vaultwarden.env 即可查看。各端客户端的自建服务器地址填 http(s)://<你的NAS>/vaultwarden，WebSocket 实时通知开箱即用。"
important    = "网页保管库解锁/登录需要 HTTPS（浏览器 WebCrypto 安全上下文限制，所有 Bitwarden 网页版固有的行为）：局域网 http 环境请使用各端 App/浏览器插件，或在 NAS 启用 HTTPS/自行加反代。安装后请立即打开网页完成账号注册（首位注册者即密码库所有者），随后关闭开放注册（SIGNUPS_ALLOWED）或改用后台邀请。apt remove 卸载时保留 /var/lib/vaultwarden 数据，apt purge 会彻底删除整个密码库数据库。"

[zh-hk]
name         = "Vaultwarden 密碼管理伺服器"
auth         = "Daniel García"
version      = "@@VERSION@@"
descript     = "Vaultwarden 是以 Rust 編寫的自架密碼管理伺服器，與 Bitwarden 協定完全相容。內建官方網頁保管庫（登入頁），並提供 /vaultwarden/admin 管理後台，可管理使用者、組織、邀請、WebSocket 即時通知與附件。各類 Bitwarden 用戶端——瀏覽器擴充功能、桌面版、行動 App——均透過 /vaultwarden/ 路由接入。服務以專用非特權使用者執行並施加 systemd 沙箱強化，資料保存在 /var/lib/vaultwarden。隱私政策：/vaultwarden/privacy-policy.html。"
release_note = "內建由官方原始碼發行版建置的 Vaultwarden @@UPSTREAM@@ 伺服端（CI 自建靜態二進位，溯源見 PROVENANCE.md）及配套網頁保管庫 @@WEBVAULT@@。安裝時會自動產生管理後台 /vaultwarden/admin 的隨機 ADMIN_TOKEN：SSH 登入 NAS 執行 grep ADMIN_TOKEN /usr/local/vaultwarden/vaultwarden.env 即可查看。各端用戶端的自建伺服器位址填 http(s)://<你的NAS>/vaultwarden，WebSocket 即時通知開箱即用。"
important    = "網頁保管庫解鎖/登入需要 HTTPS（瀏覽器 WebCrypto 安全上下文限制，所有 Bitwarden 網頁版固有的行為）：區域網路 http 環境請使用各端 App/瀏覽器擴充功能，或在 NAS 啟用 HTTPS/自行加反向代理。安裝後請立即開啟網頁完成帳號註冊（首位註冊者即密碼庫擁有者），隨後關閉開放註冊（SIGNUPS_ALLOWED）或改用後台邀請。apt remove 移除時保留 /var/lib/vaultwarden 資料，apt purge 會徹底刪除整個密碼庫資料庫。"

[fr-fr]
name         = "Vaultwarden Password Manager"
auth         = "Daniel García"
version      = "@@VERSION@@"
descript     = "Vaultwarden est un serveur de gestion de mots de passe auto-hébergé, compatible Bitwarden, écrit en Rust. Il embarque le coffre-fort web officiel (page de connexion) et un panneau d'administration sur /vaultwarden/admin pour gérer utilisateurs, organisations, invitations, notifications WebSocket et pièces jointes. Toutes les extensions de navigateur et applications Bitwarden (bureau et mobile) se connectent via la route /vaultwarden/. S'exécute sous un utilisateur dédié non privilégié dans un bac à sable systemd renforcé ; données stockées dans /var/lib/vaultwarden. Politique de confidentialité : /vaultwarden/privacy-policy.html."
release_note = "Embarque le serveur officiel Vaultwarden @@UPSTREAM@@ construit depuis la publication source officielle (binaire statique compilé par CI, voir PROVENANCE.md) et le coffre-fort web assorti @@WEBVAULT@@. Un ADMIN_TOKEN aléatoire pour le panneau /vaultwarden/admin est généré à l'installation : connectez-vous en SSH et lancez 'grep ADMIN_TOKEN /usr/local/vaultwarden/vaultwarden.env'. Pointez vos clients Bitwarden sur http(s)://<votre-NAS>/vaultwarden. Les notifications WebSocket fonctionnent immédiatement."
important    = "Le coffre-fort web dans le navigateur nécessite HTTPS pour se déverrouiller (restriction de contexte sécurisé WebCrypto, propre à tous les coffres Bitwarden). Sur un réseau local en HTTP simple, utilisez les applications/extensions Bitwarden, ou activez HTTPS sur le NAS / placez un reverse proxy. Après l'installation, ouvrez la page et créez immédiatement votre compte : la première personne inscrite possède le coffre ; désactivez ensuite l'inscription libre (SIGNUPS_ALLOWED). 'apt remove' conserve /var/lib/vaultwarden, 'apt purge' supprime toute la base."

[de-de]
name         = "Vaultwarden Password Manager"
auth         = "Daniel García"
version      = "@@VERSION@@"
descript     = "Vaultwarden ist ein selbst gehosteter, Bitwarden-kompatibler Passwort-Manager-Server in Rust. Er bringt den offiziellen Web-Tresor (Login-Seite) und ein Admin-Panel unter /vaultwarden/admin mit, um Benutzer, Organisationen, Einladungen, WebSocket-Benachrichtigungen und Anhänge zu verwalten. Alle Bitwarden-Browser-Erweiterungen sowie Desktop- und Mobil-Apps verbinden sich über die Route /vaultwarden/. Läuft als dedizierter unprivilegierter Benutzer in einer gehärteten systemd-Sandbox; Daten liegen in /var/lib/vaultwarden. Datenschutzerklärung: /vaultwarden/privacy-policy.html."
release_note = "Enthält den offiziellen Vaultwarden-Server @@UPSTREAM@@, gebaut aus der offiziellen Quell-Release (statische, per CI kompilierte Binärdatei, siehe PROVENANCE.md), plus den passenden Web-Tresor @@WEBVAULT@@. Beim Installieren wird ein zufälliger ADMIN_TOKEN für das /vaultwarden/admin-Panel erzeugt: per SSH 'grep ADMIN_TOKEN /usr/local/vaultwarden/vaultwarden.env' ausführen. Richten Sie Ihre Bitwarden-Clients auf http(s)://<Ihr-NAS>/vaultwarden. WebSocket-Benachrichtigungen funktionieren sofort."
important    = "Der Web-Tresor im Browser braucht zum Entsperren HTTPS (WebCrypto-Secure-Context-Einschränkung, allen Bitwarden-Web-Tresoren inhärent). Im reinen HTTP-LAN verwenden Sie die Bitwarden-Apps/-Erweiterungen oder aktivieren HTTPS auf dem NAS / schalten einen Reverse Proxy vor. Öffnen Sie nach der Installation sofort die Seite und legen Sie Ihr Konto an: Wer sich zuerst registriert, besitzt den Tresor; deaktivieren Sie danach freie Registrierungen (SIGNUPS_ALLOWED). 'apt remove' behält /var/lib/vaultwarden, 'apt purge' löscht die gesamte Datenbank."

[it-it]
name         = "Vaultwarden Password Manager"
