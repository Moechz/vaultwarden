[en-us]
name         = "Vaultwarden Password Manager"
auth         = "Moechz"
version      = "@@VERSION@@"
descript     = "Vaultwarden is a self-hosted, Bitwarden-compatible password manager server written in Rust. It ships the official web vault (login page) and an admin panel at /admin where you manage users, organizations, invitations, WebSocket notifications and attachments. All Bitwarden browser extensions, desktop and mobile apps can connect to your NAS directly. Opens in a new browser tab; runs as a dedicated unprivileged user in a hardened systemd sandbox. Data is stored in /var/lib/vaultwarden."
release_note = "Bundles the official Vaultwarden @@UPSTREAM@@ server (static musl binary taken from the official alpine image) plus the matching web vault @@WEBVAULT@@. A random ADMIN_TOKEN for the /admin panel is generated during installation: SSH in and run 'grep ADMIN_TOKEN /usr/local/vaultwarden/vaultwarden.env'. Point your Bitwarden clients at http://<NAS-IP>:8222. WebSocket notifications work out of the box."
important    = "The browser web vault needs HTTPS to unlock (browser WebCrypto secure-context restriction, inherent to all Bitwarden web vaults). On a plain-HTTP LAN use the Bitwarden apps/extensions, or enable HTTPS on the NAS / put a reverse proxy in front. After install, open the page immediately and create your account: the first person to register owns the vault; then disable open sign-ups (SIGNUPS_ALLOWED) or use the admin panel. 'apt remove' keeps /var/lib/vaultwarden, 'apt purge' deletes your entire vault database."

[zh-cn]
name         = "Vaultwarden 密码管理服务器"
auth         = "Moechz"
version      = "@@VERSION@@"
descript     = "Vaultwarden 是用 Rust 编写的自托管密码管理服务器，与 Bitwarden 协议完全兼容。自带官方网页保管库（登录页），并提供 /admin 管理后台，可管理用户、组织、邀请、WebSocket 实时通知与附件。各类 Bitwarden 客户端——浏览器插件、桌面端、移动 App——都能直连你的 NAS 使用。应用从 TOS 桌面以新标签页方式打开；服务以专用非特权用户运行并施加 systemd 沙箱加固。密码库数据保存在 /var/lib/vaultwarden。"
release_note = "内置 Vaultwarden @@UPSTREAM@@ 官方服务端（取自官方 alpine 镜像的静态 musl 二进制）及配套网页保管库 @@WEBVAULT@@。安装时会自动生成管理后台 /admin 的随机 ADMIN_TOKEN：SSH 登录 NAS 执行 grep ADMIN_TOKEN /usr/local/vaultwarden/vaultwarden.env 即可查看。各端客户端的自建服务器地址填 http://<NAS的IP>:8222，WebSocket 实时通知开箱即用。"
important    = "网页保管库解锁/登录需要 HTTPS（浏览器 WebCrypto 安全上下文限制，所有 Bitwarden 网页版固有的行为）：局域网 http 环境请使用各端 App/浏览器插件，或在 NAS 启用 HTTPS/自行加反代。安装后请立即打开网页完成账号注册（首位注册者即密码库所有者），随后关闭开放注册（SIGNUPS_ALLOWED）或改用后台邀请。apt remove 卸载时保留 /var/lib/vaultwarden 数据，apt purge 会彻底删除整个密码库数据库。"

[zh-hk]
name         = "Vaultwarden 密碼管理伺服器"
auth         = "Moechz"
version      = "@@VERSION@@"
descript     = "Vaultwarden 是以 Rust 編寫的自架密碼管理伺服器，與 Bitwarden 協定完全相容。內建官方網頁保管庫（登入頁），並提供 /admin 管理後台，可管理使用者、組織、邀請、WebSocket 即時通知與附件。各類 Bitwarden 用戶端——瀏覽器擴充功能、桌面版、行動 App——都能直連你的 NAS 使用。應用從 TOS 桌面以新分頁方式開啟；服務以專用非特權使用者執行並施加 systemd 沙箱強化。密碼庫資料保存在 /var/lib/vaultwarden。"
release_note = "內建 Vaultwarden @@UPSTREAM@@ 官方伺服端（取自官方 alpine 映像檔的靜態 musl 二進位）及配套網頁保管庫 @@WEBVAULT@@。安裝時會自動產生管理後台 /admin 的隨機 ADMIN_TOKEN：SSH 登入 NAS 執行 grep ADMIN_TOKEN /usr/local/vaultwarden/vaultwarden.env 即可查看。各端用戶端的自建伺服器位址填 http://<NAS的IP>:8222，WebSocket 即時通知開箱即用。"
important    = "網頁保管庫解鎖/登入需要 HTTPS（瀏覽器 WebCrypto 安全上下文限制，所有 Bitwarden 網頁版固有的行為）：區域網路 http 環境請使用各端 App/瀏覽器擴充功能，或在 NAS 啟用 HTTPS/自行加反向代理。安裝後請立即開啟網頁完成帳號註冊（首位註冊者即密碼庫擁有者），隨後關閉開放註冊（SIGNUPS_ALLOWED）或改用後台邀請。apt remove 移除時保留 /var/lib/vaultwarden 資料，apt purge 會徹底刪除整個密碼庫資料庫。"

[fr-fr]
name         = "Vaultwarden Password Manager"
auth         = "Moechz"
version      = "@@VERSION@@"
descript     = "Vaultwarden est un serveur de gestion de mots de passe auto-hébergé, compatible Bitwarden, écrit en Rust. Il embarque le coffre-fort web officiel (page de connexion) et un panneau d'administration sur /admin pour gérer utilisateurs, organisations, invitations, notifications WebSocket et pièces jointes. Toutes les extensions de navigateur et applications Bitwarden (bureau et mobile) peuvent se connecter directement à votre NAS. S'ouvre dans un nouvel onglet ; s'exécute sous un utilisateur dédié non privilégié dans un bac à sable systemd renforcé. Les données sont stockées dans /var/lib/vaultwarden."
release_note = "Embarque le serveur officiel Vaultwarden @@UPSTREAM@@ (binaire musl statique extrait de l'image alpine officielle) et le coffre-fort web assorti @@WEBVAULT@@. Un ADMIN_TOKEN aléatoire pour le panneau /admin est généré à l'installation : connectez-vous en SSH et lancez 'grep ADMIN_TOKEN /usr/local/vaultwarden/vaultwarden.env'. Pointez vos clients Bitwarden sur http://<IP-du-NAS>:8222. Les notifications WebSocket fonctionnent immédiatement."
important    = "Le coffre-fort web dans le navigateur nécessite HTTPS pour se déverrouiller (restriction de contexte sécurisé WebCrypto, propre à tous les coffres Bitwarden). Sur un réseau local en HTTP simple, utilisez les applications/extensions Bitwarden, ou activez HTTPS sur le NAS / placez un reverse proxy. Après l'installation, ouvrez la page et créez immédiatement votre compte : la première personne inscrite possède le coffre ; désactivez ensuite l'inscription libre (SIGNUPS_ALLOWED). 'apt remove' conserve /var/lib/vaultwarden, 'apt purge' supprime toute la base."

[de-de]
name         = "Vaultwarden Password Manager"
auth         = "Moechz"
version      = "@@VERSION@@"
descript     = "Vaultwarden ist ein selbst gehosteter, Bitwarden-kompatibler Passwort-Manager-Server in Rust. Er bringt den offiziellen Web-Tresor (Login-Seite) und ein Admin-Panel unter /admin mit, um Benutzer, Organisationen, Einladungen, WebSocket-Benachrichtigungen und Anhänge zu verwalten. Alle Bitwarden-Browser-Erweiterungen sowie Desktop- und Mobil-Apps verbinden sich direkt mit Ihrem NAS. Öffnet sich in einem neuen Browser-Tab; läuft als dedizierter unprivilegierter Benutzer in einer gehärteten systemd-Sandbox. Daten liegen in /var/lib/vaultwarden."
release_note = "Enthält den offiziellen Vaultwarden-Server @@UPSTREAM@@ (statische musl-Binärdatei aus dem offiziellen Alpine-Image) plus den passenden Web-Tresor @@WEBVAULT@@. Beim Installieren wird ein zufälliger ADMIN_TOKEN für das /admin-Panel erzeugt: per SSH 'grep ADMIN_TOKEN /usr/local/vaultwarden/vaultwarden.env' ausführen. Richten Sie Ihre Bitwarden-Clients auf http://<NAS-IP>:8222. WebSocket-Benachrichtigungen funktionieren sofort."
important    = "Der Web-Tresor im Browser braucht zum Entsperren HTTPS (WebCrypto-Secure-Context-Einschränkung, allen Bitwarden-Web-Tresoren inhärent). Im reinen HTTP-LAN verwenden Sie die Bitwarden-Apps/-Erweiterungen oder aktivieren HTTPS auf dem NAS / schalten einen Reverse Proxy vor. Öffnen Sie nach der Installation sofort die Seite und legen Sie Ihr Konto an: Wer sich zuerst registriert, besitzt den Tresor; deaktivieren Sie danach freie Registrierungen (SIGNUPS_ALLOWED). 'apt remove' behält /var/lib/vaultwarden, 'apt purge' löscht die gesamte Datenbank."

[it-it]
name         = "Vaultwarden Password Manager"
auth         = "Moechz"
version      = "@@VERSION@@"
descript     = "Vaultwarden è un server di gestione password self-hosted, compatibile con Bitwarden, scritto in Rust. Include la cassaforte web ufficiale (pagina di login) e un pannello di amministrazione su /admin per gestire utenti, organizzazioni, inviti, notifiche WebSocket e allegati. Tutte le estensioni browser e le app Bitwarden (desktop e mobili) possono connettersi direttamente al NAS. Si apre in una nuova scheda del browser; gira con un utente dedicato non privilegiato in una sandbox systemd rafforzata. I dati sono salvati in /var/lib/vaultwarden."
release_note = "Include il server ufficiale Vaultwarden @@UPSTREAM@@ (binario musl statico dall'immagine alpine ufficiale) e la cassaforte web abbinata @@WEBVAULT@@. All'installazione viene generato un ADMIN_TOKEN casuale per il pannello /admin: via SSH eseguire 'grep ADMIN_TOKEN /usr/local/vaultwarden/vaultwarden.env'. Configurare i client Bitwarden su http://<IP-NAS>:8222. Le notifiche WebSocket funzionano subito."
important    = "La cassaforte web nel browser richiede HTTPS per sbloccare (restrizione di contesto sicuro WebCrypto, insita in tutte le cassaforti web Bitwarden). In LAN HTTP semplice usare le app/estensioni Bitwarden, oppure attivare HTTPS sul NAS / inserire un reverse proxy. Dopo l'installazione aprire subito la pagina e creare il proprio account: il primo registrato possiede la cassaforte; disattivare poi le registrazioni libere (SIGNUPS_ALLOWED). 'apt remove' conserva /var/lib/vaultwarden, 'apt purge' elimina l'intero database."

[es-es]
name         = "Vaultwarden Password Manager"
auth         = "Moechz"
version      = "@@VERSION@@"
descript     = "Vaultwarden es un servidor autoalojado de gestión de contraseñas compatible con Bitwarden, escrito en Rust. Incluye la bóveda web oficial (página de inicio de sesión) y un panel de administración en /admin para gestionar usuarios, organizaciones, invitaciones, notificaciones WebSocket y adjuntos. Todas las extensiones de navegador y aplicaciones Bitwarden (escritorio y móvil) pueden conectarse directamente a tu NAS. Se abre en una pestaña nueva; se ejecuta con un usuario dedicado sin privilegios en una sandbox systemd reforzada. Los datos se guardan en /var/lib/vaultwarden."
release_note = "Incluye el servidor oficial Vaultwarden @@UPSTREAM@@ (binario musl estático de la imagen alpine oficial) y la bóveda web correspondiente @@WEBVAULT@@. Durante la instalación se genera un ADMIN_TOKEN aleatorio para el panel /admin: conéctate por SSH y ejecuta 'grep ADMIN_TOKEN /usr/local/vaultwarden/vaultwarden.env'. Apunta tus clientes Bitwarden a http://<IP-del-NAS>:8222. Las notificaciones WebSocket funcionan de inmediato."
important    = "La bóveda web en el navegador necesita HTTPS para desbloquearse (restricción de contexto seguro de WebCrypto, inherente a todas las bóvedas web de Bitwarden). En una LAN HTTP simple usa las apps/extensiones Bitwarden, o activa HTTPS en el NAS / coloca un proxy inverso. Tras instalar, abre la página y crea tu cuenta de inmediato: la primera persona registrada es la propietaria; desactiva luego el registro libre (SIGNUPS_ALLOWED). 'apt remove' conserva /var/lib/vaultwarden, 'apt purge' borra toda la base de datos."

[ja-jp]
name         = "Vaultwarden パスワードマネージャー"
auth         = "Moechz"
version      = "@@VERSION@@"
descript     = "Vaultwarden は Rust 製のセルフホスト型パスワード管理サーバーで、Bitwarden と完全互換です。公式ウェブ保管庫（ログインページ）と /admin 管理パネルを同梱し、ユーザー・組織・招待・WebSocket 通知・添付ファイルを管理できます。Bitwarden のブラウザ拡張・デスクトップ・モバイルアプリから NAS に直接接続できます。新しいタブで開き、専用の非特権ユーザーと強化された systemd サンドボックスで動作します。データは /var/lib/vaultwarden に保存されます。"
release_note = "公式 Alpine イメージ由来の静的 musl バイナリである Vaultwarden @@UPSTREAM@@ サーバーと、対応するウェブ保管庫 @@WEBVAULT@@ を同梱。インストール時に /admin パネル用のランダムな ADMIN_TOKEN を自動生成します：SSH で 'grep ADMIN_TOKEN /usr/local/vaultwarden/vaultwarden.env' を実行して確認してください。Bitwarden クライアントには http://<NASのIP>:8222 を指定します。WebSocket 通知は即利用可能です。"
important    = "ブラウザのウェブ保管庫はロック解除に HTTPS が必要です（WebCrypto のセキュアコンテキスト制限により、Bitwarden ウェブ版すべてに共通）。HTTP の LAN では各種アプリ／拡張機能を使うか、NAS で HTTPS を有効化／リバースプロキシを設置してください。インストール後すぐにページを開いてアカウントを作成してください（最初に登録した人が保管庫の所有者になります）。その後、自由な新規登録（SIGNUPS_ALLOWED）を無効化してください。'apt remove' は /var/lib/vaultwarden を保持し、'apt purge' はデータベース全体を削除します。"

[ko-kr]
name         = "Vaultwarden 비밀번호 관리자"
auth         = "Moechz"
version      = "@@VERSION@@"
descript     = "Vaultwarden은 Rust로 작성된 자체 호스팅 비밀번호 관리 서버로 Bitwarden과 완전히 호환됩니다. 공식 웹 금고(로그인 페이지)와 /admin 관리 패널을 포함하여 사용자, 조직, 초대, WebSocket 알림, 첨부 파일을 관리할 수 있습니다. Bitwarden 브라우저 확장·데스크톱·모바일 앱이 NAS에 직접 연결됩니다. 새 탭에서 열리며 전용 비특권 사용자와 강화된 systemd 샌드박스로 실행됩니다. 데이터는 /var/lib/vaultwarden에 저장됩니다."
release_note = "공식 Alpine 이미지의 정적 musl 바이너리인 Vaultwarden @@UPSTREAM@@ 서버와 함께 짝이 맞는 웹 금고 @@WEBVAULT@@를 포함합니다. 설치 시 /admin 패널용 무작위 ADMIN_TOKEN이 자동 생성됩니다: SSH로 접속해 'grep ADMIN_TOKEN /usr/local/vaultwarden/vaultwarden.env'를 실행하세요. Bitwarden 클라이언트에는 http://<NAS의-IP>:8222를 지정합니다. WebSocket 알림은 바로 사용할 수 있습니다."
important    = "브라우저 웹 금고의 잠금 해제에는 HTTPS가 필요합니다(WebCrypto 보안 컨텍스트 제한, 모든 Bitwarden 웹 버전에 내재됨). HTTP LAN에서는 각종 앱/확장 기능을 사용하거나 NAS에서 HTTPS를 활성화/리버스 프록시를 구성하세요. 설치 후 즉시 페이지를 열어 계정을 만드세요(첫 등록자가 금고 소유자가 됨). 이후 자유 가입(SIGNUPS_ALLOWED)을 비활성화하세요. 'apt remove'는 /var/lib/vaultwarden을 유지하고 'apt purge'는 전체 데이터베이스를 삭제합니다."

[ru-ru]
name         = "Vaultwarden Password Manager"
auth         = "Moechz"
version      = "@@VERSION@@"
descript     = "Vaultwarden — самостоятельно размещаемый сервер менеджера паролей, совместимый с Bitwarden, на Rust. Включает официальное веб-хранилище (страница входа) и панель администратора /admin для управления пользователями, организациями, приглашениями, WebSocket-уведомлениями и вложениями. Все расширения браузера и приложения Bitwarden (десктоп и мобильные) подключаются к NAS напрямую. Открывается в новой вкладке; работает от выделенного непривилегированного пользователя в усиленной песочнице systemd. Данные хранятся в /var/lib/vaultwarden."
release_note = "Включает официальный сервер Vaultwarden @@UPSTREAM@@ (статический musl-бинарник из официального alpine-образа) и соответствующее веб-хранилище @@WEBVAULT@@. При установке генерируется случайный ADMIN_TOKEN для панели /admin: подключитесь по SSH и выполните 'grep ADMIN_TOKEN /usr/local/vaultwarden/vaultwarden.env'. Укажите в клиентах Bitwarden адрес http://<IP-NAS>:8222. WebSocket-уведомления работают сразу."
important    = "Веб-хранилищу в браузере для разблокировки нужен HTTPS (ограничение защищённого контекста WebCrypto, присущее всем веб-хранилищам Bitwarden). В HTTP-локальной сети используйте приложения/расширения Bitwarden либо включите HTTPS на NAS / поставьте reverse proxy. Сразу после установки откройте страницу и создайте аккаунт: первый зарегистрировавшийся владеет хранилищем; затем отключите свободную регистрацию (SIGNUPS_ALLOWED). 'apt remove' сохраняет /var/lib/vaultwarden, 'apt purge' удаляет всю базу целиком."

[pt-pt]
name         = "Vaultwarden Password Manager"
