#!/bin/bash
# postrm - 删除/清除后处理（官方模板 + 本应用清理项）
set -e

MAINT_LOG=/var/log/vaultwarden-maint.log
mkdir -p /var/log 2>/dev/null || true
echo "$(date '+%F %T') postrm $*" >> "$MAINT_LOG" 2>/dev/null || true

systemctl daemon-reload 2>/dev/null || true

if [ "$1" = "purge" ]; then
  # ⚠ 密码库数据库/附件/Send/图标缓存——purge 即全部清除，remove 时保留
  rm -rf /var/lib/vaultwarden
  # 系统层注册文件（postinst 兜底安装的）
  rm -f /etc/systemd/system/vaultwarden.service
  rm -f /etc/nginx/conf.d/vaultwarden.conf
  # 运行用户
  if id -u vaultwarden > /dev/null 2>&1; then
    userdel vaultwarden 2>/dev/null || true
  fi
  systemctl daemon-reload 2>/dev/null || true
  # nginx 路由移除后重载生效
  if command -v nginx > /dev/null 2>&1 && nginx -t > /dev/null 2>&1; then
    nginx -s reload > /dev/null 2>&1 || true
  fi
  # 注：/var/log/vaultwarden-maint.log 保留（purge 取证用）
  # 注：/usr/local/vaultwarden 由 dpkg 按包清单删除；但首装生成的
  # vaultwarden.env（含 ADMIN_TOKEN）与 postinst 解压的 index.html
  # 不在清单里，此处补清
  rm -f /usr/local/vaultwarden/vaultwarden.env
  rm -f /usr/local/vaultwarden/index.html
  rmdir --ignore-fail-on-non-empty /usr/local/vaultwarden 2>/dev/null || true
fi

exit 0
