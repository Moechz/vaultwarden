#!/bin/bash
# postinst - 安装/升级后处理
# 组件树（/usr/local/vaultwarden 下的二进制/web-vault/配置/服务）随 deb 分发，
# postinst 负责"派生状态"：属主、ADMIN_TOKEN 首装生成、系统层注册、启动服务。
# 注：经 TOS 应用中心安装时平台也会注册 init.d 服务与 nginx 配置，
# 本脚本的操作全部幂等，两条安装路径行为一致。
# S8 合规：本脚本不执行任何在线安装/网络下载。
set -e

APP_DIR=/usr/local/vaultwarden
APP_USER=vaultwarden
DATA_DIR=/var/lib/vaultwarden
MAINT_LOG=/var/log/vaultwarden-maint.log

pkg_log() {
  mkdir -p /var/log 2>/dev/null || true
  echo "$(date '+%F %T') $*" >> "$MAINT_LOG" 2>/dev/null || true
}
pkg_log postinst "$1" "new=@VERSION@${2:+ old=$2}"

gen_token() { # 96 位十六进制随机令牌（openssl 优先，回退 /dev/urandom）
  if command -v openssl > /dev/null 2>&1; then
    openssl rand -hex 48 2>/dev/null && return
  fi
  head -c 48 /dev/urandom | od -An -tx1 | tr -d ' \n'
}

case "$1" in
  configure)
    # 1. 用户兜底（preinst 已建；平台自动创建路径亦覆盖）
    if ! id -u $APP_USER > /dev/null 2>&1; then
      useradd --system --user-group --no-create-home --shell /usr/sbin/nologin $APP_USER 2>/dev/null || true
    fi

    # 2. 文件属主（官方 postinst 模板：应用目录归运行用户；
    #    web-vault 数千文件由 dpkg 随包展开，属主统一收敛）
    chown -R $APP_USER:$APP_USER "$APP_DIR" 2>/dev/null || true

    # 3. webui.bz2 解压（官方模板行为；路由模式下为入口跳转页）
    if [ -f "$APP_DIR/webui.bz2" ]; then
      ( cd "$APP_DIR" && tar -xjf webui.bz2 2>/dev/null || true )
    fi

    # 4. 配置文件首装引导：仅在不存在时从随包模板复制（升级永不覆盖用户配置）
    #    并生成随机 ADMIN_TOKEN（管理后台 /vaultwarden/admin 的口令；只在此处生成，
    #    绝不打印到安装输出/日志，防止经 App Center 日志泄露）
    if [ ! -e "$APP_DIR/vaultwarden.env" ] && [ -e "$APP_DIR/vaultwarden.env.example" ]; then
      install -m 0640 -o $APP_USER -g $APP_USER \
        "$APP_DIR/vaultwarden.env.example" "$APP_DIR/vaultwarden.env"
      tok=$(gen_token)
      if [ -n "$tok" ]; then
        printf '\n# ↓ 首装自动生成的管理后台令牌（/vaultwarden/admin 登录用；可自行更换或改为 argon2 哈希）\nADMIN_TOKEN=%s\n' \
          "$tok" >> "$APP_DIR/vaultwarden.env"
        chown $APP_USER:$APP_USER "$APP_DIR/vaultwarden.env"
        pkg_log postinst bootstrap "vaultwarden.env + ADMIN_TOKEN 首装生成"
      else
        pkg_log postinst bootstrap "vaultwarden.env 首装（ADMIN_TOKEN 生成失败，请手工设置）"
        echo "警告: ADMIN_TOKEN 自动生成失败，请手工编辑 $APP_DIR/vaultwarden.env 设置。" >&2
      fi
    fi

    # 5. 数据目录（数据库/附件/Send/图标缓存等均由 DATA_FOLDER 派生）
    install -d -o $APP_USER -g $APP_USER -m 0750 "$DATA_DIR"

    # 6. 系统层注册（幂等；应用中心安装时平台也会做同样的事）
    install -m 0644 "$APP_DIR/init.d/vaultwarden.service" \
      /etc/systemd/system/vaultwarden.service
    systemctl daemon-reload

    # 启用（幂等，升级路径 prerm 只停不拆故必须重 enable）并（重）启动
    systemctl enable vaultwarden.service > /dev/null 2>&1 || true
    if [ -n "${2:-}" ]; then
      systemctl restart vaultwarden.service 2>/dev/null || true
    else
      systemctl start vaultwarden.service 2>/dev/null || true
    fi

    # 7. nginx 网关路由（保留前缀反代 127.0.0.1:8222 + 隐私政策精确路由；
    #    平台会加载 nginx/<appid>.conf，此处往系统 nginx conf.d 镜像注册）。
    #    写入后立即 nginx -t 校验，失败即回滚，
    #    绝不留下导致 nginx 无法 reload 的配置（原生 Ubuntu 的 conf.d 在 http 层）
    if command -v nginx > /dev/null 2>&1 && [ -d /etc/nginx/conf.d ]; then
      install -m 0644 "$APP_DIR/nginx/vaultwarden.conf" \
        /etc/nginx/conf.d/vaultwarden.conf
      if nginx -t > /dev/null 2>&1; then
        nginx -s reload > /dev/null 2>&1 || true
      else
        rm -f /etc/nginx/conf.d/vaultwarden.conf
        pkg_log postinst "conf.d 不在 server 上下文，跳过 nginx 兜底注册"
      fi
    fi

    # 8. 就绪检查（curl 轮询 /alive，30s 上限；超时打印有限状态快照，不阻塞安装）
    ok=""
    for i in $(seq 1 15); do
      if curl -sf -o /dev/null --max-time 2 http://127.0.0.1:8222/vaultwarden/alive 2>/dev/null; then
        ok=1
        break
      fi
      sleep 2
    done
    if [ -n "$ok" ]; then
      pkg_log postinst "vaultwarden /vaultwarden/alive ok"
    else
      echo "警告: 服务 30s 内未就绪，排查: journalctl -u vaultwarden -n 50 --no-pager" >&2
      systemctl status vaultwarden.service --no-pager -n 10 > /dev/null 2>&1 || true
      systemctl is-failed --quiet vaultwarden.service && \
        echo "（服务状态: failed，请查看上方 journalctl 输出）" >&2 || true
    fi

    pkg_log postinst done "@VERSION@"
    echo ""
    if [ -n "${2:-}" ]; then
      echo "Vaultwarden @VERSION@ 已完成升级（自 $2）。"
    else
      echo "Vaultwarden @VERSION@ 已安装。"
    fi
    echo "  打开界面 : TOS 桌面 → Vaultwarden 图标（经 /vaultwarden/ 路由打开）"
    echo "  首次使用 : 打开网页 → 创建账户（首位注册者即密码库所有者，请立即完成）"
    echo "  管理后台 : http(s)://<NAS管理地址>/vaultwarden/admin"
    echo "  管理令牌 : ssh 到 NAS 执行  grep ADMIN_TOKEN /usr/local/vaultwarden/vaultwarden.env"
    echo "             （首装自动生成；更换后 systemctl restart vaultwarden 生效）"
    echo "  各端连接 : 浏览器插件/桌面/移动 App 的自建服务器地址填 http(s)://<NAS>/vaultwarden"
    echo "  隐私政策 : http(s)://<NAS管理地址>/vaultwarden/privacy-policy.html"
    echo "  ⚠ HTTPS  : 网页保管库登录需要 HTTPS（浏览器安全限制，Bitwarden 固有行为）；"
    echo "             局域网 http 环境请使用各端客户端，或在 NAS 上启用 HTTPS/自建反代"
    echo "  数据位置 : /var/lib/vaultwarden（apt remove 保留，apt purge 彻底删除）"
    echo ""
    ;;
esac

exit 0
