# ============================================================
# Vaultwarden 用户配置（由 vaultwarden.env.example 首装复制而来）
# 修改后执行: systemctl restart vaultwarden
#
# 说明：服务仅监听回环 127.0.0.1:8222，用户一律经 TOS 桌面/管理入口
# http(s)://<NAS管理地址>/vaultwarden/ 访问，请勿改动监听地址与端口。
# 本文件可覆盖 unit 内置的一切默认值（EnvironmentFile 声明在其后）。
# 完整选项: https://github.com/dani-garcia/vaultwarden/blob/main/.env.template
#
# ADMIN_TOKEN 由 postinst 首装时自动生成并追加在本文件末尾，
# 查看方式: grep ADMIN_TOKEN /usr/local/vaultwarden/vaultwarden.env
# 管理后台: http(s)://<NAS管理地址>/vaultwarden/admin
# ============================================================

# 对外访问地址（影响邮件里的链接、WebAuthn/FIDO2/passkey 的 origin 校验、
# 以及部分客户端能力协商）。
# ⚠️ 路径部分 /vaultwarden 是路由挂载前缀，与 nginx 网关联动，绝对不可改；
#    只能按实际访问方式修改协议/主机/端口，例如：
#DOMAIN=http://192.168.1.10:8181/vaultwarden
#DOMAIN=https://vault.example.com/vaultwarden

# 是否开放自助注册（默认 true：安装后第一个注册的账号即所有者；
# 全员注册完成后建议改为 false，之后由管理后台邀请）
#SIGNUPS_ALLOWED=true

# 仅允许指定邮箱域名的用户自助注册（逗号分隔，配 SIGNUPS_ALLOWED=false
# 时这些域名仍可自助注册）
#SIGNUPS_DOMAINS_WHITELIST=family.example.com

# 邀请用户时邮件中显示的名称
#INVITATION_ORG_NAME=Vaultwarden

# ---------------- 邮件（SMTP）----------------
# 注册验证/邀请/密码提示等邮件功能需要配置 SMTP；不配置则相关功能关闭，
# 核心密码库功能不受影响。
#SMTP_HOST=smtp.example.com
#SMTP_FROM=vaultwarden@example.com
#SMTP_PORT=587
#SMTP_SECURITY=starttls
#SMTP_USERNAME=username
#SMTP_PASSWORD=password

# ---------------- 其他常用项 ----------------
# 工作线程数（默认按 CPU 数）
#ROCKET_WORKERS=4

# 日志级别（可选值见上游文档；默认 info）
#LOG_LEVEL=info

# 禁用网站图标下载（默认会按条目域名向外网请求 favicon 做缓存；
# 隐私敏感环境可设 ICON_SERVICE=internal 完全关闭外联）
#ICON_SERVICE=internal
#ICON_BLACKLIST_REGEX=^(192\.168\.10\..*|localhost)
